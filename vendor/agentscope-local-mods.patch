+def entry_id_key(entry_id: str) -> tuple[int, int]:
+    """Return a comparable key for a replay-log entry id.
+
+    Both backends mint ids of the form ``"<major>-<minor>"`` where both
+    parts are integers — Redis Streams use ``"<ms>-<seq>"`` and the
+    in-memory log uses ``"<seq>-0"``. Comparing the raw strings is
+    **wrong** for both (``"1699-9"`` sorts after ``"1699-10"``), so ids
+    are compared as integer pairs instead.
+
+    This lives here rather than in a backend because callers must never
+    parse ids themselves: the ordering rule is a transport detail, and a
+    caller that assumed one backend's id shape would silently misorder
+    another's.
+
+    Args:
+        entry_id (`str`):
+            An id previously returned by ``log_append`` / ``log_read``.
+
+    Returns:
+        `tuple[int, int]`:
+            ``(major, minor)``, ordered like the ids themselves.
+
+    Raises:
+        `ValueError`: If the id does not have the ``"<int>-<int>"``
+            shape, which means the caller passed something that is not
+            a replay-log entry id.
+    """
+    major, _, minor = entry_id.partition("-")
+    try:
+        return int(major), int(minor)
+    except ValueError as exc:
+        raise ValueError(
+            f"Not a replay-log entry id: {entry_id!r}",
+        ) from exc
+
