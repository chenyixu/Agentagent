+async def get_current_principal(request: Request) -> Principal:
+    """Resolve the trusted production identity configured on the app.
+
+    The provider is responsible for validating a JWT/OAuth token or a
+    gateway-authenticated identity assertion.  There is intentionally no
+    header fallback here: a production app must fail closed when the
+    provider is missing or rejects the request.
+
+    Args:
+        request (`Request`): The current HTTP request.
+
+    Returns:
+        `Principal`: Immutable, verified identity and scope claims.
+
+    Raises:
+        `HTTPException`: 503 when no provider is configured, or 500 when a
+            provider violates the application contract.
+    """
+    state = getattr(request, "state", None)
+    cached = getattr(state, "principal", None)
+    if isinstance(cached, Principal):
+        return cached
+
+    provider = getattr(request.app.state, "identity_provider", None)
+    if provider is None:
+        raise HTTPException(
+            status_code=status.HTTP_503_SERVICE_UNAVAILABLE,
+            detail="Trusted identity provider is not configured.",
+        )
+    principal = await provider(request)
+    if not isinstance(principal, Principal):
+        raise HTTPException(
+            status_code=status.HTTP_500_INTERNAL_SERVER_ERROR,
+            detail="Identity provider returned an invalid principal.",
+        )
+    if state is not None:
+        state.principal = principal
+    return principal
