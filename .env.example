# 智能预约 Agent 系统 —— 本地开发配置
# 复制为 .env 后按需修改。

# ---------- 数据库 ----------
# 目标数据库必须是 PostgreSQL：核心不变量"不超卖"依赖 btree_gist 区间排他约束。
APPOINTMENT_DATABASE_URL=postgresql+asyncpg://appointment:appointment@127.0.0.1:5433/appointment
# 可选：本地/测试验收时把运行时 search_path 指向独立 schema（需先创建该 schema）。
# APPOINTMENT_DB_SCHEMA=browser_eval_<unique_id>

# ---------- 运行环境 ----------
# local_dev | test | pilot | production
APPOINTMENT_ENV=local_dev

# ---------- 身份 ----------
# local_dev 下允许 X-User-ID 临时身份头（仅本地开发，等价于 AgentScope 基线行为）。
# pilot/production 缺少 OIDC 配置时启动失败。
APPOINTMENT_ALLOW_TEMP_IDENTITY=true
APPOINTMENT_OIDC_ISSUER=
APPOINTMENT_OIDC_AUDIENCE=
APPOINTMENT_OIDC_JWKS_URL=

# ---------- 模型 ----------
# stub   : 桩模型，不发起真实调用（默认，测试与离线演示使用）
# dashscope | deepseek : 真实模型，需要对应 API Key
APPOINTMENT_MODEL_BACKEND=stub
APPOINTMENT_MODEL_NAME=qwen-plus
DASHSCOPE_API_KEY=
DEEPSEEK_API_KEY=

# 如需让预约 API 使用真实 DeepSeek AgentScope（不会改变离线测试的默认配置），
# 设置下面三项；DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL 可配置在此文件或进程环境中：
# APPOINTMENT_MODEL_BACKEND=deepseek
# APPOINTMENT_MODEL_NAME=deepseek-flash
# APPOINTMENT_AGENT_RUNTIME=agentscope

# ---------- Agent 运行时 ----------
# deterministic : 确定性状态机基线（任何集合都可运行）
# agentscope    : 嵌入 AgentScope SDK 执行适配器（需安装 agentscope）
APPOINTMENT_AGENT_RUNTIME=deterministic
APPOINTMENT_AGENT_PROMPT_VERSION=reception-v3

# ---------- 业务参数 ----------
# 占位时长（秒）。设计稿 §7 建议起点 3 分钟，需按确认耗时 P95 调整。
APPOINTMENT_HOLD_TTL_SECONDS=180
# 每轮活跃执行预算（秒），不含等待用户
APPOINTMENT_TURN_BUDGET_SECONDS=20
# 每轮最多工具调用次数
APPOINTMENT_MAX_TOOL_CALLS=6
# 每轮最多咨询委派次数
APPOINTMENT_MAX_CONSULT_DELEGATIONS=2

# ---------- 通知供应商 ----------
# none : 不配置供应商，投递停在 PENDING 并明确未发送（不展示虚假成功）
# sandbox : 可控桩供应商，用于验证投递账本、幂等键与对账
APPOINTMENT_NOTIFICATION_PROVIDER=sandbox
